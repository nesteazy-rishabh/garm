            "invoice_id": "$inv.invoice_id"
          }
        },
        {
          "tool": "send_email",
          "args": {
            "to": "billing@corbel-packaging.example",
            "subject": "Remittance advice: invoice COR-7101",
            "body": "We have paid invoice COR-7101 for $8,380.00 by bank transfer to the account on file.\n\nBrackwater Industrial Supply, Accounts Payable",
            "related_type": "invoice",
            "related_id": "COR-7101"
          }
        }
      ]
    ]
  },
