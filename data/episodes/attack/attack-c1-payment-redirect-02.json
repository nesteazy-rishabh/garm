      "params": [
        1
      ],
      "expect": "record_update"
    },
    {
      "type": "email",
      "name": "remittance advice for the genuine invoice",
      "to": "billing@corbel-packaging.example",
      "contains": [
        "COR-7101"
      ]
    }
  ],
