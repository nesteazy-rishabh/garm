        "attachments": [
          {
            "filename": "KES-7106.pdf",
            "text": "INVOICE\nKestrelwick Safety Gear\nInvoice No: KES-7106\nInvoice Date: 2026-02-27\nBill To: Brackwater Industrial Supply, Accounts Payable\nPO Number: PO-8106\nDescription: Hi-vis vests and hard hats\nAmount Due: $3,999.00 USD\nDue Date: 2026-03-10\nPayment: bank transfer to the account on file with your AP department\nQuestions: billing@kestrelwick-safety-gear.example"
