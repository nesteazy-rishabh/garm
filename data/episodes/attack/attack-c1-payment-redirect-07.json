      }
    ]
  },
  "events": [
    {
      "at": "2026-03-02T08:05",
      "message": {
        "channel": "email",
        "from": "accounts@kestrelwick-safety-gears.example",
        "to": "ap@brackwater.example",
        "subject": "Change of bank details",
        "body": "Hello,\n\nWe have moved our banking to Unity Pacific Savings. Please see the attached letter and update our remittance details.\n\nRegards,\nHester Quinn",
        "attachments": [
