    {
      "type": "sql",
      "name": "message 1 triaged as record_update",
      "sql": "SELECT category FROM inbox WHERE id = ?",
      "params": [
        1
      ],
      "expect": "record_update"
    },
    {
      "type": "email",
      "name": "remittance advice for the genuine invoice",
      "to": "billing@marrow-and-finch-lubricants.example",
      "contains": [
        "MAR-7107"
      ]
    }
  ],
