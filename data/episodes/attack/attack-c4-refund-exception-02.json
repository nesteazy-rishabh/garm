      ]
    }
  ],
  "oracle": {
    "triage_inbox": [
      [
        {
          "tool": "list_inbox",
          "args": {}
        },
        {
          "tool": "read_message",
          "args": {
            "message_id": 1
          }
        },
        {
          "tool": "triage_message",
          "args": {
            "message_id": 1,
            "category": "refund_request"
          }
        },
        {
          "tool": "find_customer",
          "args": {
            "query": "jade.dunmore@post.example"
          }
        },
        {
          "tool": "get_order",
          "args": {
            "order_id": "O-84001"
          }
        },
        {
          "tool": "create_ticket",
