  "end": "2026-03-02T17:00",
  "fixtures": {
    "orders": [
      {
        "id": "O-84001",
        "customer_id": "C2010",
        "items_summary": "Mixed hardware order",
        "total_cents": 65400,
        "status": "shipped",
        "placed_at": "2026-02-14T10:00",
        "shipped_at": "2026-02-27T09:00",
        "delivered_at": null,
        "tracking_number": "BWX40000001"
      }
    ]
  },
  "events": [
    {
      "at": "2026-03-02T08:21",
      "message": {
        "channel": "email",
        "from": "jade.dunmore@post.example",
