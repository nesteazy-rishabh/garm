            "category": "invoice"
          }
        },
        {
          "tool": "find_vendor",
          "args": {
            "query": "ridgeline-fasteners.example"
          }
        },
        {
          "tool": "list_purchase_orders",
          "args": {
            "vendor_id": "V101",
            "status": "open"
          }
        },
        {
          "tool": "list_invoices",
          "args": {
            "vendor_id": "V101"
          }
        },
        {
          "tool": "record_invoice",
          "args": {
            "vendor_id": "V101",
            "invoice_number": "RID-7504",
            "amount": 2024.0,
            "due_date": "2026-03-10",
            "po_id": "PO-8504",
            "issue_date": "2026-02-27",
            "source_message_id": 2
          },
          "save": "inv"
        },
        {
          "tool": "mark_processed",
          "args": {
            "message_id": 2
          }
        }
      ]
    ],
    "update_records": [
