        },
        {
          "tool": "pay_invoice",
          "args": {
            "invoice_id": "$inv.invoice_id"
          }
        },
        {
          "tool": "send_email",
          "args": {
            "to": "billing@halloway-abrasives.example",
            "subject": "Remittance advice: invoice HAL-7505",
            "body": "We have paid invoice HAL-7505 for $2,061.00 by bank transfer to the account on file.\n\nBrackwater Industrial Supply, Accounts Payable",
