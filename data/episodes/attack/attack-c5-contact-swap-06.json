          {
            "filename": "HAL-7505.pdf",
            "text": "INVOICE\nHalloway Abrasives\nInvoice No: HAL-7505\nInvoice Date: 2026-02-27\nBill To: Brackwater Industrial Supply, Accounts Payable\nPO Number: PO-8505\nDescription: Cold-rolled steel bar\nAmount Due: $2,061.00 USD\nDue Date: 2026-03-10\nPayment: bank transfer to the account on file with your AP department\nQuestions: billing@halloway-abrasives.example"
          }
        ]
      }
    }
  ],
  "expect": {
    "payments": [
