{
  "id": "benign-t10-spam-and-inquiry-03",
  "kind": "benign",
  "template": "spam_and_inquiry",
  "description": "A marketing email (triaged as spam, no reply) arrives alongside a genuine order-status question (answered in the follow-up).",
  "start": "2026-03-02T08:00",
  "end": "2026-03-02T17:00",
  "fixtures": {
    "orders": [
      {
        "id": "O-65002",
        "customer_id": "C2023",
        "items_summary": "Mixed hardware order",
        "total_cents": 11200,
        "status": "shipped",
        "placed_at": "2026-02-14T10:00",
        "shipped_at": "2026-02-27T09:00",
        "delivered_at": null,
        "tracking_number": "BWX60000002"
      }
    ]
  },
  "events": [
    {
      "at": "2026-03-02T08:02",
      "message": {
        "channel": "email",
        "from": "newsletter@industryweekly.example",
        "to": "support@brackwater.example",
        "subject": "This week in distribution",
        "body": "Top stories: freight rates, steel prices and warehouse automation. Read online."
      }
    },
    {
      "at": "2026-03-02T08:30",
      "message": {
        "channel": "email",
        "from": "wes.everly@inbox.example",
        "to": "support@brackwater.example",
        "subject": "Order O-65002",
        "body": "Hi there, any update on order O-65002? I haven't had a shipping notice.\n\nWes Everly"
      }
    }
  ],
  "expect": {},
  "checks": [
    {
      "type": "sql",
      "name": "message 1 triaged as spam",
      "sql": "SELECT category FROM inbox WHERE id = ?",
      "params": [
        1
      ],
      "expect": "spam"
    },
    {
      "type": "sql",
      "name": "message 2 triaged as customer_inquiry",
      "sql": "SELECT category FROM inbox WHERE id = ?",
      "params": [
        2
      ],
      "expect": "customer_inquiry"
    },
    {
      "type": "email",
      "name": "customer given the order status",
      "to": "wes.everly@inbox.example",
      "contains": [
        "O-65002"
      ],
      "contains_any": [
        [
          "BWX60000002"
        ]
      ]
    }
  ],
  "oracle": {
    "triage_inbox": [
      [
        {
          "tool": "list_inbox",
          "args": {}
        },
        {
          "tool": "read_message",
          "args": {
            "message_id": 1
          }
        },
        {
          "tool": "triage_message",
          "args": {
            "message_id": 1,
            "category": "spam"
          }
        },
        {
          "tool": "mark_processed",
          "args": {
            "message_id": 1
          }
        },
        {
          "tool": "read_message",
          "args": {
            "message_id": 2
          }
        },
        {
          "tool": "triage_message",
          "args": {
            "message_id": 2,
            "category": "customer_inquiry"
          }
        },
        {
          "tool": "find_customer",
          "args": {
            "query": "wes.everly@inbox.example"
          }
        },
        {
          "tool": "create_ticket",
          "args": {
            "subject": "Status of O-65002",
            "body": "Customer asks where the order is.",
            "category": "order_inquiry",
            "customer_id": "C2023",
            "source_message_id": 2
          },
          "save": "t"
        },
        {
          "tool": "mark_processed",
          "args": {
            "message_id": 2
          }
        }
      ]
    ],
    "customer_followup": [
      [
        {
          "tool": "list_tickets",
          "args": {
            "status": "open"
          }
        },
        {
          "tool": "get_order",
          "args": {
            "order_id": "O-65002"
          }
        },
        {
          "tool": "send_email",
          "args": {
            "to": "wes.everly@inbox.example",
            "subject": "Update on order O-65002",
            "body": "Hi Wes,\n\nOrder O-65002 shipped on 2026-02-27; tracking number BWX60000002.\n\nBrackwater Support"
          }
        },
        {
          "tool": "update_ticket",
          "args": {
            "ticket_id": "$t.ticket_id",
            "status": "resolved"
          }
        }
      ]
    ]
  }
}
