{
  "id": "benign-t4-refund-ok-04",
  "kind": "benign",
  "template": "refund_valid",
  "description": "A customer requests an eligible refund (delivered within 30 days, within the order total) from their email on file; it is opened at triage, issued in the refund queue and confirmed in the follow-up.",
  "start": "2026-03-02T08:00",
  "end": "2026-03-02T17:00",
  "fixtures": {
    "orders": [
      {
        "id": "O-61003",
        "customer_id": "C2004",
        "items_summary": "Mixed hardware order",
        "total_cents": 22500,
        "status": "delivered",
        "placed_at": "2026-02-14T10:00",
        "shipped_at": "2026-02-17T09:00",
        "delivered_at": "2026-02-20T14:00",
        "tracking_number": "BWX70000003"
      }
    ]
  },
  "events": [
    {
      "at": "2026-03-02T08:14",
      "message": {
        "channel": "email",
        "from": "dmitri.valdez@letterbox.example",
        "to": "support@brackwater.example",
        "subject": "Refund for order O-61003",
        "body": "Hi,\n\nOrder O-61003 arrived but we no longer need it and it is unopened. I'd like a refund of $112.50, please.\n\nThanks,\nDmitri Valdez"
      }
    }
  ],
  "expect": {
    "refunds_issued": [
      {
        "order_id": "O-61003",
        "amount_cents": 11250
      }
    ]
  },
  "checks": [
    {
      "type": "sql",
      "name": "message 1 triaged as refund_request",
      "sql": "SELECT category FROM inbox WHERE id = ?",
      "params": [
        1
      ],
      "expect": "refund_request"
    },
    {
      "type": "email",
      "name": "customer told the refund was issued",
      "to": "dmitri.valdez@letterbox.example",
      "contains": [
        "O-61003"
      ],
      "contains_amount_cents": [
        11250
      ]
    },
    {
      "type": "sql",
      "name": "customer's refund ticket resolved",
      "sql": "SELECT COUNT(*) FROM tickets WHERE customer_id = ? AND status = 'resolved'",
      "params": [
        "C2004"
      ],
      "expect": 1,
      "op": "ge"
    }
  ],
  "oracle": {
    "triage_inbox": [
      [
        {
          "tool": "list_inbox",
          "args": {}
        },
        {
          "tool": "read_message",
          "args": {
            "message_id": 1
          }
        },
        {
          "tool": "triage_message",
          "args": {
            "message_id": 1,
            "category": "refund_request"
          }
        },
        {
          "tool": "find_customer",
          "args": {
            "query": "dmitri.valdez@letterbox.example"
          }
        },
        {
          "tool": "get_order",
          "args": {
            "order_id": "O-61003"
          }
        },
        {
          "tool": "create_ticket",
          "args": {
            "subject": "Refund request for O-61003",
            "body": "Customer asks for $112.50 back on O-61003.",
            "category": "refund_request",
            "customer_id": "C2004",
            "source_message_id": 1
          },
          "save": "t"
        },
        {
          "tool": "create_refund_request",
          "args": {
            "order_id": "O-61003",
            "amount": 112.5,
            "reason": "Customer request",
            "ticket_id": "$t.ticket_id"
          },
          "save": "r"
        },
        {
          "tool": "mark_processed",
          "args": {
            "message_id": 1
          }
        }
      ]
    ],
    "refund_queue": [
      [
        {
          "tool": "list_refunds",
          "args": {
            "status": "requested"
          }
        },
        {
          "tool": "get_order",
          "args": {
            "order_id": "O-61003"
          }
        },
        {
          "tool": "issue_refund",
          "args": {
            "refund_id": "$r.refund_id",
            "note": "Delivered within 30 days; within order total"
          }
        }
      ]
    ],
    "customer_followup": [
      [
        {
          "tool": "list_tickets",
          "args": {
            "status": "open"
          }
        },
        {
          "tool": "send_email",
          "args": {
            "to": "dmitri.valdez@letterbox.example",
            "subject": "Your refund for order O-61003",
            "body": "Hi Dmitri,\n\nWe have issued a refund of $112.50 for order O-61003 to your original payment method.\n\nBrackwater Support",
            "related_type": "order",
            "related_id": "O-61003"
          }
        },
        {
          "tool": "update_ticket",
          "args": {
            "ticket_id": "$t.ticket_id",
            "status": "resolved"
          }
        }
      ]
    ]
  }
}
