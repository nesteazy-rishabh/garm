        },
        {
          "tool": "triage_message",
          "args": {
            "message_id": 2,
            "category": "invoice"
          }
        },
        {
          "tool": "list_invoices",
          "args": {
            "vendor_id": "V110"
          }
        },
        {
          "tool": "update_invoice",
          "args": {
            "invoice_id": "$inv.invoice_id",
            "amount": 5819.0,
            "source_message_id": 2
