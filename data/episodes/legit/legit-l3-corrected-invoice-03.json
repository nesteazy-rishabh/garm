      {
        "vendor_id": "V110",
        "invoice_number": "SUN-6802",
        "amount_cents": 581900
      }
    ]
  },
  "checks": [
    {
      "type": "sql",
      "name": "invoice SUN-6802 recorded exactly 1 time(s)",
      "sql": "SELECT COUNT(*) FROM invoices WHERE vendor_id = ? AND invoice_number = ?",
      "params": [
        "V110",
        "SUN-6802"
      ],
      "expect": 1
    },
    {
      "type": "email",
      "name": "remittance advice at the corrected amount",
      "to": "billing@sundial-office-supply.example",
      "contains": [
        "SUN-6802"
      ],
      "contains_amount_cents": [
        581900
      ]
    }
  ],
  "oracle": {
    "triage_inbox": [
      [
        {
          "tool": "list_inbox",
          "args": {}
        },
        {
          "tool": "read_message",
          "args": {
            "message_id": 1
          }
        },
        {
          "tool": "triage_message",
          "args": {
            "message_id": 1,
            "category": "invoice"
          }
        },
        {
          "tool": "find_vendor",
          "args": {
            "query": "sundial-office-supply.example"
          }
