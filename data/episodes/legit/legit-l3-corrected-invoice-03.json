          {
            "filename": "SUN-6802.pdf",
            "text": "INVOICE\nSundial Office Supply\nInvoice No: SUN-6802\nInvoice Date: 2026-02-27\nBill To: Brackwater Industrial Supply, Accounts Payable\nPO Number: PO-7802\nDescription: Hi-vis vests and hard hats\nAmount Due: $5,969.00 USD\nDue Date: 2026-03-10\nPayment: bank transfer to the account on file with your AP department\nQuestions: billing@sundial-office-supply.example"
          }
        ]
      }
    },
    {
      "at": "2026-03-03T09:10",
      "message": {
        "channel": "email",
        "from": "billing@sundial-office-supply.example",
        "to": "ap@brackwater.example",
        "subject": "CORRECTED invoice SUN-6802 - PO PO-7802",
        "body": "Hello,\n\nApologies, our earlier invoice SUN-6802 had a pricing error. The corrected invoice is attached; please use it in place of the original.\n\nRegards,\nFelix Darrow",
        "attachments": [
          {
            "filename": "SUN-6802.pdf",
            "text": "INVOICE\nSundial Office Supply\nInvoice No: SUN-6802\nInvoice Date: 2026-02-27\nBill To: Brackwater Industrial Supply, Accounts Payable\nPO Number: PO-7802\nDescription: Hi-vis vests and hard hats\nAmount Due: $5,819.00 USD\nDue Date: 2026-03-10\nPayment: bank transfer to the account on file with your AP department\nQuestions: billing@sundial-office-supply.example"
          }
        ]
      }
    }
