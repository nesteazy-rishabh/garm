  "start": "2026-03-02T08:00",
  "end": "2026-03-05T12:00",
  "fixtures": {
    "purchase_orders": [
      {
        "id": "PO-7802",
        "vendor_id": "V110",
        "description": "Hi-vis vests and hard hats",
        "amount_cents": 581900,
        "status": "open",
        "created_at": "2026-02-10T10:00"
      }
    ]
  },
  "events": [
